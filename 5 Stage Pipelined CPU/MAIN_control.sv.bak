module MAIN_control (instruction, zero, Reg2Loc, Uncondbranch, Branch, MemRead, MemtoReg, ALUOp, MemWrite, ALUSrc, RegWrite, Link, set_flags, Immediate, cbz, BtoR);
	input logic [10:0] instruction;
	input logic zero;
	output logic Reg2Loc, Uncondbranch, Branch, MemRead, MemtoReg, MemWrite, ALUSrc, RegWrite, Link, set_flags, Immediate, cbz, BtoR;
	
	output logic [2:0] ALUOp;
	
	always_comb begin
		casex (instruction)
			11'b1001000100X: 	begin	//ADDI
										Reg2Loc = 1'b1;
										Uncondbranch = 1'bX;
										Branch = 1'b0;
										MemRead = 1'bX;
										MemtoReg = 1'b0;
										ALUOp = 3'b010;
										MemWrite = 1'b0;
										ALUSrc = 1'b1;
										RegWrite = 1'b1;
										Link = 1'b0;
										set_flags = 1'b0;
										Immediate = 1'b1;
										cbz = 1'b0;
										BtoR = 1'b0;
									end
									
			11'b10101011000: 	begin	//ADDS
										Reg2Loc = 1'b1;
										Uncondbranch = 1'bX;
										Branch = 1'b0;
										MemRead = 1'bX;
										MemtoReg = 1'b0;
										ALUOp = 3'b010;
										MemWrite = 1'b0;
										ALUSrc = 1'b0;
										RegWrite = 1'b1;
										Link = 1'b0;
										set_flags = 1'b1;
										Immediate = 1'b0;
										cbz = 1'b0;
										BtoR = 1'b0;
									end
									
			11'b000101XXXXX: 	begin	//Branch
										Reg2Loc = 1'bX;
										Uncondbranch = 1'b1;
										Branch = 1'b1;
										MemRead = 1'bX;
										MemtoReg = 1'bX;
										ALUOp = 3'bXXX;
										MemWrite = 1'b0;
										ALUSrc = 1'bX;
										RegWrite = 1'b0;
										Link = 1'b0;
										set_flags = 1'b0;
										Immediate = 1'b0;
										cbz = 1'b0;
										BtoR = 1'b0;
									end
									
			11'b01010100XXX: 	begin	//Branch Conditional
										Reg2Loc = 1'bX;
										Uncondbranch = 1'b0;
										Branch = 1'b1;
										MemRead = 1'bX;
										MemtoReg = 1'bX;
										ALUOp = 3'bXXX;
										MemWrite = 1'b0;
										ALUSrc = 1'bX;
										RegWrite = 1'b0;
										Link = 1'b0;
										set_flags = 1'b0;
										Immediate = 1'b0;
										cbz = 1'b0;
										BtoR = 1'b0;
										end
									
			11'b100101XXXXX: 	begin	//Branch with Link
										Reg2Loc = 1'bX;
										Uncondbranch = 1'b1;
										Branch = 1'b1;
										MemRead = 1'bX;
										MemtoReg = 1'bX;
										ALUOp = 3'bXXX;
										MemWrite = 1'b0;
										ALUSrc = 1'bX;
										RegWrite = 1'b1;
										Link = 1'b1;
										set_flags = 1'b0;
										Immediate = 1'b0;
										cbz = 1'b0;
										BtoR = 1'b0;
									end
									
			11'b11010110000: 	begin	//Branch to register
										Reg2Loc = 1'b0;
										Uncondbranch = 1'b1; 
										Branch = 1'b1;
										MemRead = 1'bX;
										MemtoReg = 1'b0;
										ALUOp = 3'bxxx;	//pass Rd data through 
										MemWrite = 1'b0;
										ALUSrc = 1'b1;
										RegWrite = 1'b0;
										Link = 1'b0;
										set_flags = 1'b0;
										Immediate = 1'b0;
										cbz = 1'b0;
										BtoR = 1'b1;
									end
									
			11'b10110100XXX: 	begin	//CBZ
										Reg2Loc = 1'b0;
										Uncondbranch = 1'b0;
										Branch = zero;	//zero flag
										MemRead = 1'bX;
										MemtoReg = 1'bX;
										ALUOp = 3'b000;
										MemWrite = 1'b0;
										ALUSrc = 1'b0;
										RegWrite = 1'b0;
										Link = 1'b0;
										set_flags = 1'b0;
										Immediate = 1'b1;
										cbz = 1'b1;
										BtoR = 1'b0;
									end
										
			11'b11111000010: 	begin	//LDUR
										Reg2Loc = 1'bX;
										Uncondbranch = 1'bX;
										Branch = 1'b0;
										MemRead = 1'b1;
										MemtoReg = 1'b1;
										ALUOp = 3'b010;
										MemWrite = 1'b0;
										ALUSrc = 1'b1;
										RegWrite = 1'b1;
										Link = 1'b0;
										set_flags = 1'b0;
										Immediate = 1'b0;
										cbz = 1'b0;
										BtoR = 1'b0;
									end
										
			11'b11111000000: 	begin	//STUR
										Reg2Loc = 1'b0;
										Uncondbranch = 1'bX;
										Branch = 1'b0;
										MemRead = 1'bX;
										MemtoReg = 1'bX;
										ALUOp = 3'b010;
										MemWrite = 1'b1;
										ALUSrc = 1'b1;
										RegWrite = 1'b0;
										Link = 1'b0;
										set_flags = 1'b0;
										Immediate = 1'b0;
										cbz = 1'b0;
										BtoR = 1'b0;
									end
									
			11'b11101011000: begin	//SUBS
										Reg2Loc = 1'b1;
										Uncondbranch = 1'bX;
										Branch = 1'b0;
										MemRead = 1'bX;
										MemtoReg = 1'b0;
										ALUOp = 3'b011;
										MemWrite = 1'b0;
										ALUSrc = 1'b0;
										RegWrite = 1'b1;
										Link = 1'b0;
										set_flags = 1'b1;
										Immediate = 1'b0;
										cbz = 1'b0;
										BtoR = 1'b0;
									end
									
		endcase
	end


endmodule 


module MAIN_control_testbench ();
	logic [10:0] instruction;
	logic [3:0] flags;
	logic Reg2Loc, Uncondbranch, Branch, MemRead, MemtoReg, MemWrite, ALUSrc, RegWrite, Link, set_flags, Immediate;
	logic [2:0] ALUOp;
	
	MAIN_control dut (.*);
	
	
	initial begin
		flags <= 0;
		instruction <= 11'b1001000100X; #10;
		
		instruction <= 11'b10101011000; #10;
		
		instruction <= 11'b000101XXXXX; #10;
		
		$stop;
	
	end
	
endmodule
